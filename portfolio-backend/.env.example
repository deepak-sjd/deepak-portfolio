

DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
SERVER_PORT=8080

# Shared secret for admin-protected endpoints (all writes + GET /api/v1/contact
# + GET /api/v1/services/admin). Send it as the X-Admin-Api-Key header.
# Generate a long random value, e.g.: openssl rand -base64 32
ADMIN_API_KEY=change_me_to_a_long_random_value

# Comma-separated origins allowed to call this API. Add your real deployed
# frontend domain here once you have one, e.g. https://deepakkumar.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
